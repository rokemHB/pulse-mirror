# Copy to .env (never commit .env). All values are optional; defaults shown.

# Where the database, Garmin tokens and reports live (a mounted volume on the NAS)
PULSE_DATA_DIR=./data
# Timezone used for "today" and the schedule
TZ=Europe/Berlin
# Web/API port (LAN only)
PULSE_PORT=8420
# Daily sync time (local time, HH:MM) and how many days back each sync refreshes
PULSE_SYNC_TIME=08:00
PULSE_SYNC_DAYS=3
# Minimum seconds between Garmin requests (be gentle; don't go below ~2)
PULSE_GARMIN_DELAY_S=3.0

# Weekly PDF report (Sundays at this time). Point the directory at a Synology Drive folder
# that is mounted into the container to get the PDFs synced to your devices.
PULSE_REPORT_TIME=20:00
# PULSE_REPORT_DIR=/reports

# Morning summary by email after the daily sync (leave PULSE_SMTP_HOST empty to disable).
# Test with: pulse-mirror notify test
PULSE_SMTP_HOST=
PULSE_SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
PULSE_SMTP_SECURITY=starttls
PULSE_SMTP_USER=
PULSE_SMTP_PASSWORD=
PULSE_SMTP_FROM=
PULSE_NOTIFY_TO=
